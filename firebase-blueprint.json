{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile, color/gradient theme, language, avatar, and saved study music",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User verified email address",
          "maxLength": 200
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional profile photo URL",
          "maxLength": 1000
        },
        "themeId": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,40}$",
          "minLength": 2,
          "maxLength": 40,
          "description": "Selected solid or gradient app color theme ID"
        },
        "language": {
          "type": "string",
          "enum": ["en", "ar", "genz", "fr", "arz"],
          "description": "Selected UI language"
        },
        "avatar": {
          "type": "object",
          "description": "Avataaars customization map"
        },
        "savedMusic": {
          "type": "array",
          "description": "Saved Spotify and custom audio tracks"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user record was created"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user record was last updated"
        }
      },
      "required": ["ownerId", "displayName", "email", "themeId", "language", "createdAt", "updatedAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "A scheduled exam belonging to a user calendar",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "maxLength": 128
        },
        "subject": {
          "type": "string",
          "description": "Course or subject name",
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "enum": ["final", "midterm", "monthly", "quiz", "practical", "oral", "other"],
          "description": "Exam category"
        },
        "date": {
          "type": "string",
          "description": "ISO date YYYY-MM-DD",
          "maxLength": 20
        },
        "startTime": {
          "type": "string",
          "description": "24-hour HH:MM start time",
          "maxLength": 10
        },
        "endTime": {
          "type": "string",
          "description": "24-hour HH:MM end time",
          "maxLength": 10
        },
        "room": {
          "type": "string",
          "description": "Exam room or hall",
          "maxLength": 120
        },
        "material": {
          "type": "string",
          "description": "Covered textbooks or study materials",
          "maxLength": 500
        },
        "topics": {
          "type": "array",
          "description": "List of covered topics or lessons"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes",
          "maxLength": 1000
        },
        "sourceChatKey": {
          "type": "string",
          "description": "Optional chat message origin key",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update server timestamp"
        }
      },
      "required": ["ownerId", "subject", "type", "date", "createdAt", "updatedAt"]
    },
    "LessonItem": {
      "title": "LessonItem",
      "description": "A study checklist lesson or topic belonging to a user",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "maxLength": 128
        },
        "subject": {
          "type": "string",
          "description": "Subject name",
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "description": "Lesson title or topic",
          "maxLength": 300
        },
        "notes": {
          "type": "string",
          "description": "Optional study notes",
          "maxLength": 1000
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the lesson has been studied"
        },
        "examId": {
          "type": "string",
          "description": "Optional linked exam ID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update server timestamp"
        }
      },
      "required": ["ownerId", "subject", "title", "completed", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-private user settings, color/gradient theme, avatar, and saved music"
    },
    "/users/{userId}/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Owner-private scheduled exams"
    },
    "/users/{userId}/lessons/{lessonId}": {
      "schema": { "$ref": "#/entities/LessonItem" },
      "description": "Owner-private study checklist lessons"
    }
  }
}
